const RestoreSkillInfoCheckboxStatic = {
	BuildDate: 20260106,
	TabsCallVir: 0x009B0DC7,
	TabsCallBytes: "E8 44 E7 FF FF",
	TabsFnVir: 0x009AF510,
	MouseMoveSlotVir: 0x011431A0,
	MouseMoveSlotBytes: "E0 15 9B 00",
	MouseMoveFnVir: 0x009B15E0,
	OperatorNewVir: 0x00E5E8FF,
	MsgStringGetByIdVir: 0x00AFF910,
	ToggleButtonCtorVir: 0x0084DCD0,
	ToggleButtonSetStateVir: 0x00864590,
	ToggleButtonSetSkinVir: 0x00864110,
	WindowSetSizeVir: 0x00A79E80,
	AddChildControlVir: 0x00A78A90,
	IsPointInListVir: 0x009AFC90,
	GetNodeAtVir: 0x009AF440,
	CursorOffsetVir: 0x00A7C280,
	MakeWindowVir: 0x00A962E0,
	ToggleWindowVir: 0x00AA8D20,
	WndMgrVir: 0x01450FE0,
	ShowSkillDescriptVir: 0x0172C010,
	SimplicityVir: 0x0172C00C,
	SceneRenderQueueVir: 0x01382FA8,
	MsgViewSkillInfo: 0x560,
	UiRootHex: "C0 AF C0 FA C0 CE C5 CD C6 E4 C0 CC BD BA 5C",
	CheckOffName: "checkbox_0.bmp",
	CheckOnName: "checkbox_1.bmp",
	DataCaveSize: 0x40,
	DataSlotSize: 0x20,
	CreateCaveSize: 0xA0,
	HoverCaveSize: 0x180
};

RestoreSkillInfoCheckboxStatic.compactHex = function(hex)
{
	return (hex || "").replace(/[^0-9A-Fa-f]/g, "").toUpperCase();
};

RestoreSkillInfoCheckboxStatic.assertBytes = function(label, virAddr, expected)
{
	const S = RestoreSkillInfoCheckboxStatic;
	const phyAddr = Exe.Vir2Phy(virAddr);
	if (phyAddr < 0)
		throw Error(`${label} is not mapped`);
	const wanted = S.compactHex(expected);
	const actual = S.compactHex(Exe.GetHex(phyAddr, wanted.length / 2));
	if (actual !== wanted)
		throw Error(`${label}: expected ${wanted}, found ${actual}`);
	return phyAddr;
};

RestoreSkillInfoCheckboxStatic.asciiHex = function(text)
{
	const out = [];
	for (let i = 0; i < text.length; ++i)
		out.push(text.charCodeAt(i).toHex(1));
	return out.join(" ");
};

function RSICAsm(baseVir)
{
	this.base = baseVir;
	this.bytes = [];
	this.labels = {};
	this.fixups = [];
}

RSICAsm.prototype.here = function() { return this.base + this.bytes.length; };
RSICAsm.prototype.size = function() { return this.bytes.length; };
RSICAsm.prototype.hex = function(text)
{
	const parts = text.trim().split(/\s+/).filter(Boolean);
	for (const part of parts) {
		const value = parseInt(part, 16);
		if (isNaN(value) || value < 0 || value > 0xFF)
			throw Error(`RestoreSkillInfoCheckbox: bad byte '${part}'`);
		this.bytes.push(value);
	}
	return this;
};
RSICAsm.prototype.dword = function(value)
{
	const v = value >>> 0;
	this.bytes.push(v & 0xFF, (v >>> 8) & 0xFF, (v >>> 16) & 0xFF, (v >>> 24) & 0xFF);
	return this;
};
RSICAsm.prototype.callAbs = function(target)
{
	this.hex("E8");
	this.dword(target - (this.here() + 4));
	return this;
};
RSICAsm.prototype.jmpAbs = function(target)
{
	this.hex("E9");
	this.dword(target - (this.here() + 4));
	return this;
};
RSICAsm.prototype.mark = function(name)
{
	this.labels[name] = this.bytes.length;
	return this;
};
RSICAsm.prototype.fix = function(opcode, name, size)
{
	this.hex(opcode);
	this.fixups.push({name: name, at: this.bytes.length, size: size});
	this.hex(size === 1 ? "00" : "00 00 00 00");
	return this;
};
RSICAsm.prototype.jcc = function(cc, name) { return this.fix("0F " + cc, name, 4); };
RSICAsm.prototype.jccShort = function(cc, name) { return this.fix(cc, name, 1); };
RSICAsm.prototype.jmpLabel = function(name) { return this.fix("E9", name, 4); };
RSICAsm.prototype.build = function()
{
	for (const fix of this.fixups) {
		if (!(fix.name in this.labels))
			throw Error(`RestoreSkillInfoCheckbox: undefined label '${fix.name}'`);
		const delta = this.labels[fix.name] - (fix.at + fix.size);
		if (fix.size === 1) {
			if (delta < -128 || delta > 127)
				throw Error(`RestoreSkillInfoCheckbox: short jump overflow`);
			this.bytes[fix.at] = delta & 0xFF;
		} else {
			const v = delta >>> 0;
			for (let i = 0; i < 4; ++i)
				this.bytes[fix.at + i] = (v >>> (8 * i)) & 0xFF;
		}
	}
	return this.bytes.map(b => b.toHex(1)).join(" ");
};

/// \brief Restores the skill-info checkbox and hover behavior.
RestoreSkillInfoCheckbox = function(_)
{
	const S = RestoreSkillInfoCheckboxStatic;
	if (Exe.BuildDate !== S.BuildDate)
		throw Error("RestoreSkillInfoCheckbox supports only the 2026-01-07 client");

	let stage = "verify";
	try {
	$$(_, 1, `Verify the skill window`);
	const tabsCallPhy = S.assertBytes("skill-window call", S.TabsCallVir, S.TabsCallBytes);
	const mouseSlotPhy = S.assertBytes("mouse-move slot", S.MouseMoveSlotVir, S.MouseMoveSlotBytes);

	stage = "data";
	const [dataPhy, dataVir] = Exe.Allocate(S.DataCaveSize, 0x10);
	const bmpOffVir = dataVir;
	const bmpOnVir = dataVir + S.DataSlotSize;
	Exe.SetHex(dataPhy, S.UiRootHex + " " + S.asciiHex(S.CheckOffName) + " 00");
	Exe.SetHex(dataPhy + S.DataSlotSize, S.UiRootHex + " " + S.asciiHex(S.CheckOnName) + " 00");

	stage = "checkbox";
	$$(_, 2, `Add the checkbox`);
	const [createPhy, createVir] = Exe.Allocate(S.CreateCaveSize, 0x10);
	const create = new RSICAsm(createVir);
	create.hex("53 56 8B D9 68 0C 01 00 00").callAbs(S.OperatorNewVir);
	create.hex("83 C4 04 85 C0").jcc("84", "done");
	create.hex("8B C8").callAbs(S.ToggleButtonCtorVir).hex("8B F0");
	create.hex("6A 0C 6A 01 8B CE").callAbs(S.WindowSetSizeVir);
	create.hex("68").dword(S.MsgViewSkillInfo).callAbs(S.MsgStringGetByIdVir).hex("83 C4 04");
	create.hex("50 68").dword(bmpOffVir).hex("68").dword(bmpOnVir).hex("8B CE").callAbs(S.ToggleButtonSetSkinVir);
	create.hex("8B 43 14 2B 46 14 83 E8 22 6A 05 50 8B CE 8B 06 FF 50 10");
	create.hex("33 C0 83 3D").dword(S.ShowSkillDescriptVir).hex("00 0F 95 C0 50 8B CE").callAbs(S.ToggleButtonSetStateVir);
	create.hex("56 8B CB").callAbs(S.AddChildControlVir);
	create.mark("done").hex("8B CB 5E 5B").jmpAbs(S.TabsFnVir);
	if (create.size() > S.CreateCaveSize)
		throw Error("RestoreSkillInfoCheckbox: checkbox stub is too large");
	stage = "checkbox build";
	Exe.SetHex(createPhy, create.build());

	stage = "hover";
	$$(_, 3, `Restore hover details`);
	const [hoverPhy, hoverVir] = Exe.Allocate(S.HoverCaveSize, 0x10);
	const hover = new RSICAsm(hoverVir);
	hover.hex("55 8B EC 83 EC 14 53 56 57 8B D9");
	hover.hex("FF 75 0C FF 75 08 8B CB").callAbs(S.MouseMoveFnVir).hex("89 45 EC");
	hover.hex("83 3D").dword(S.ShowSkillDescriptVir).hex("00").jcc("84", "done");
	hover.hex("FF 75 0C FF 75 08 8B CB").callAbs(S.IsPointInListVir).hex("84 C0").jcc("84", "hide");
	hover.hex("83 3D").dword(S.SimplicityVir).hex("00").jccShort("74", "inlist");
	hover.hex("83 7D 08 60").jcc("8F", "hide").mark("inlist");
	hover.hex("8B BB 50 02 00 00 83 FF FF").jcc("84", "hide");
	hover.hex("6A 00 57 8D 45 F0 50 8B CB").callAbs(S.GetNodeAtVir);
	hover.hex("80 7D F4 00").jcc("84", "hide");
	hover.hex("8B 75 F0 83 7E 04 00").jcc("84", "hide");
	hover.hex("6A 2E B9").dword(S.WndMgrVir).callAbs(S.MakeWindowVir);
	hover.hex("8B F8 85 FF").jcc("84", "done");
	hover.hex("8B 17 8B CF 6A 01 FF 76 18 FF 76 20 FF 76 10 6A 3D 6A 00 FF 92 94 00 00 00");
	hover.hex("C7 45 FC 00 00 00 00 C7 45 F8 00 00 00 00");
	hover.hex("8D 45 F8 50 8D 45 FC 50 8B CB").callAbs(S.CursorOffsetVir);
	hover.hex("8B 45 FC 8B 5D 08 83 C0 18 8B 4F 14 03 D8");
	hover.hex("8B 35").dword(S.SceneRenderQueueVir);
	hover.hex("8B 55 F8 03 55 0C 8D 04 19 3B 46 28").jccShort("7E", "keepx");
	hover.hex("B8 D0 FF FF FF 2B C1 03 D8").mark("keepx");
	hover.hex("8B 47 18 8B F2 2B F0 8D 0C 10 A1").dword(S.SceneRenderQueueVir);
	hover.hex("3B 48 2C 8B CF 0F 4E F2 8B 17 33 C0 85 F6 0F 49 C6 50 53 FF 52 10");
	hover.hex("6A 01 6A 2E B9").dword(S.WndMgrVir).callAbs(S.ToggleWindowVir).jmpLabel("done");
	hover.mark("hide").hex("6A 00 6A 2E B9").dword(S.WndMgrVir).callAbs(S.ToggleWindowVir);
	hover.mark("done").hex("8B 45 EC 5F 5E 5B 8B E5 5D C2 08 00");
	if (hover.size() > S.HoverCaveSize)
		throw Error("RestoreSkillInfoCheckbox: hover stub is too large");
	stage = "hover build";
	Exe.SetHex(hoverPhy, hover.build());

	stage = "hooks";
	Exe.SetCALL(tabsCallPhy, createVir, 0);
	Exe.SetUint32(mouseSlotPhy, hoverVir);
	return true;
	} catch (error) {
		throw Error(`RestoreSkillInfoCheckbox ${stage}: ${error}`);
	}
};

RestoreSkillInfoCheckbox.validate = function()
{
	return Exe.BuildDate === RestoreSkillInfoCheckboxStatic.BuildDate;
};
