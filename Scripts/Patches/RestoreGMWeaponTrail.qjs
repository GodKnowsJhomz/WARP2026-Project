/// \brief Restores regular weapon sprites and trails for GM accounts.
RestoreGMWeaponTrail = function(_)
{
	if (Exe.BuildDate !== 20260106)
		throw Error("RestoreGMWeaponTrail supports only the 2026-01-07 client");

	const head =
		"E8 ?? ?? ?? ?? 83 C4 04 84 C0";
	const tail =
		" FF ?? 10 01 00 00 E8 ?? ?? ?? ??";
	const shapes = [
		{
			name: "weapon trail",
			count: 10,
			code: head + " 74 1D" + tail
				+ " 8B ?? B4 04 00 00 83 C4 04"
		},
		{
			name: "weapon sprite",
			count: 3,
			code: head + " 74 50" + tail
				+ " 8B ?? 60 02 00 00 83 C4 04 84 C0"
		}
	];

	$$(_, 1, `Locate the GM weapon branches`);
	shapes.forEach(shape => {
		const addrs = Exe.FindHexN(shape.code);
		if (addrs.length !== shape.count)
			throw Error(`${shape.name}: found ${addrs.length}, expected ${shape.count}`);
		addrs.forEach(addr => Exe.SetJMP(addr + 10));
	});

	return true;
};

RestoreGMWeaponTrail.validate = function()
{
	return Exe.BuildDate === 20260106;
};
